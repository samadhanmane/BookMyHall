NODE_ENV=development
PORT=4000

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/college-management

# Auth (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# Email (optional — booking/requisition notifications skipped if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=MITAOE Unified ERP

# Frontend origin for CORS and email links
FRONTEND_URL=http://localhost:5173

# Bootstrap super admin (optional, dev only)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Logging: error | warn | info | debug
LOG_LEVEL=info
